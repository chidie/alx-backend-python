#!/usr/bin/env bash

echo "=== Deploying BLUE version ==="
kubectl apply -f blue_deployment.yaml

echo "=== Deploying GREEN version ==="
kubectl apply -f green_deployment.yaml

echo "=== Applying Service (initially pointing to BLUE) ==="
kubectl apply -f kubeservice.yaml

echo "=== Checking running pods ==="
kubectl get pods -o wide

echo "=== Checking logs for GREEN version ==="
GREEN_POD=$(kubectl get pods -l version=green -o jsonpath="{.items[0].metadata.name}")

echo "Green pod: $GREEN_POD"
kubectl logs "$GREEN_POD"

echo "=== If logs look good, switch service selector to GREEN in kubeservice.yaml ==="
echo "Then run: kubectl apply -f kubeservice.yaml"
